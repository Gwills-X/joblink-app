generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model chat_rooms {
  id                                      BigInt     @id @default(autoincrement())
  participant_one                         String     @db.VarChar(36)
  participant_two                         String     @db.VarChar(36)
  created_at                              DateTime?  @default(now()) @db.Timestamp(0)
  users_chat_rooms_participant_oneTousers users      @relation("chat_rooms_participant_oneTousers", fields: [participant_one], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_rooms_ibfk_1")
  users_chat_rooms_participant_twoTousers users      @relation("chat_rooms_participant_twoTousers", fields: [participant_two], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "chat_rooms_ibfk_2")
  messages                                messages[]

  @@index([participant_one], map: "participant_one")
  @@index([participant_two], map: "participant_two")
}

model follows {
  id                               BigInt   @id @default(autoincrement())
  follower_id                      String   @db.VarChar(36)
  followed_id                      String   @db.VarChar(36)
  created_at                       DateTime @default(now()) @db.Timestamp(0)
  users_follows_followed_idTousers users    @relation("follows_followed_idTousers", fields: [followed_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_followed")
  users_follows_follower_idTousers users    @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_follower")

  @@unique([follower_id, followed_id], map: "unique_follow")
  @@index([followed_id], map: "idx_followed_id")
  @@index([follower_id], map: "idx_follower_id")
}

model likes {
  user_id    String   @db.VarChar(36)
  post_id    String   @db.VarChar(36)
  created_at DateTime @default(now()) @db.Timestamp(0)

  @@id([user_id, post_id])
}

model messages {
  id         BigInt     @id @default(autoincrement())
  room_id    BigInt
  sender_id  String     @db.VarChar(36)
  content    String     @db.Text
  is_read    Boolean?   @default(false)
  created_at DateTime?  @default(now()) @db.Timestamp(0)
  chat_rooms chat_rooms @relation(fields: [room_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_1")
  users      users      @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "messages_ibfk_2")

  @@index([room_id], map: "room_id")
  @@index([sender_id], map: "sender_id")
}

model posts {
  id         String   @id @db.VarChar(36)
  authorId   String   @db.VarChar(36)
  author     String   @db.VarChar(255)
  title      String?  @db.VarChar(255)
  content    String   @db.Text
  
  // New JobLink specific fields
  type       String   @default("POST") // POST, ARTICLE, JOB_ANNOUNCEMENT
  companyId  String?  @db.VarChar(36)  // If posted by a company
  
  parent_id  String?  @db.VarChar(36)
  created_at DateTime @default(now()) @db.Timestamp(0)
  
  file_type  String   @default("none") @db.VarChar(20)
  format     String?  @db.VarChar(10)
  media_url  String?  @db.VarChar(255)
  public_id  String?  @db.VarChar(255)
  category   String?  @default("General") @db.VarChar(50)

  // Explicit Relation (Optional but recommended for Prisma)
  user       users    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
  @@index([companyId])
}

model users {
  id                 String      @id @db.VarChar(36)
  name               String      @db.VarChar(255)
  email              String      @unique(map: "email") @db.VarChar(255)
  password           String      @db.VarChar(255)

  created_at         DateTime    @default(now()) @db.Timestamp(0)
  updated_at         DateTime?   @updatedAt @db.Timestamp(0)

  profile_pic_url    String?     @db.VarChar(255)

  role               users_role? @default(user)

  bio                String?     @db.Text

  // New JobLink Fields
  headline           String?     @db.VarChar(255)
  phone              String?     @db.VarChar(20)
  is_verified        Boolean     @default(false)
  profile_visibility Boolean     @default(true)

  github_handle      String?     @db.VarChar(100)
  website_url        String?     @db.VarChar(255)
  location           String?     @db.VarChar(100)

  // Keep for now (we'll remove it later)
  interest_field     String?     @default("General") @db.VarChar(100)

  chat_rooms_chat_rooms_participant_oneTousers chat_rooms[] @relation("chat_rooms_participant_oneTousers")
  chat_rooms_chat_rooms_participant_twoTousers chat_rooms[] @relation("chat_rooms_participant_twoTousers")
  follows_follows_followed_idTousers           follows[]    @relation("follows_followed_idTousers")
  follows_follows_follower_idTousers           follows[]    @relation("follows_follower_idTousers")
  messages                                     messages[]
}

enum users_role {
  user
  employer
  recruiter
  admin
}